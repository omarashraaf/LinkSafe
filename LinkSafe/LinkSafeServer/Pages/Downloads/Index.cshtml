@page
@model LinkSafeServer.Pages.Downloads.IndexModel
@{
    ViewData["Title"] = "Downloads";
}

<section class="page-grid">
    <div class="hero-card">
        <h1>Client Downloads</h1>
        <p>Enter only the server IP. LinkSafe will generate one preconfigured setup EXE, download it immediately, and remove that generated copy after the download finishes.</p>
    </div>

    <form method="post" asp-page-handler="Generate" class="panel-card grid-form">
        <label>
            Server IP to embed in the setup file
            <input asp-for="ServerIp" class="form-control" placeholder="10.0.0.102" />
        </label>

        <div class="button-row">
            <button type="submit" class="btn btn-primary">Generate And Download Setup EXE</button>
        </div>

        <p>The downloaded setup app already knows the full server URL and will fetch the agent automatically in the background when the user clicks enable.</p>
    </form>
</section>
