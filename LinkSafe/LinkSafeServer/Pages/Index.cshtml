@page
@model LinkSafeServer.Pages.IndexModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-grid" data-live-url="@Url.Page("/Index", new { live = 1 })">
    <div class="hero-card panel-header">
        <div><h1>Your backups, at a glance</h1><p>Keep an eye on your computers, recent backups, and storage.</p></div>
        <a class="btn btn-primary" asp-page="/Clients/Index">Manage clients</a>
        <span class="small muted" data-live-status role="status">Connecting to live updates...</span>
    </div>
    <div class="stats-row" data-live-region="stats">
        <div><span>Registered clients</span><strong>@Model.Summary.TotalRegisteredClients</strong></div>
        <div><span>Recently connected</span><strong>@Model.Summary.RecentClients</strong></div>
        <div><span>Failed backups</span><strong>@Model.Summary.FailedBackupsCount</strong></div>
        <div><span>Storage used (approx.)</span><strong>@Model.StorageUsageDisplay</strong><small>Measured about once a minute</small></div>
    </div>
    <div class="card-grid" data-live-region="summary">
        <section class="panel-card">
            <div class="panel-header"><h2>Server &amp; storage</h2><span class="status" data-status="@Model.Summary.ServerStatus">@Model.Summary.ServerStatus</span></div>
            <dl class="details-grid">
                <dt>Backup location</dt><dd class="path-field">@Model.Summary.BackupRoot</dd>
                <dt>Latest backup</dt><dd>@(Model.Summary.LastBackupTime?.ToLocalTime().ToString("g") ?? "No backups yet")</dd>
            </dl>
            <a class="btn btn-outline-primary btn-sm mt-3" asp-page="/Settings">Storage settings</a>
        </section>
        <section class="panel-card">
            <h2>Recent errors</h2>
            @if (Model.Summary.RecentErrors.Count == 0)
            {
                <p class="mt-3">No recent errors reported.</p><p class="small">Client details show the latest status for each computer.</p>
            }
            else
            {
                <ul class="compact-list">@foreach (var error in Model.Summary.RecentErrors) { <li>@error</li> }</ul>
            }
            <a class="btn btn-outline-primary btn-sm mt-3" asp-page="/Logs/Index">View server logs</a>
        </section>
    </div>
    <section class="panel-card" data-live-region="activity">
        <div class="panel-header"><h2>Recent backup activity</h2><span class="muted small">Latest reported jobs</span></div>
        @if (Model.Summary.RecentJobs.Count == 0)
        {
            <div class="empty-state"><strong>Your first backup will appear here</strong>Install an agent on a computer to get started. <a asp-page="/Downloads/Index">Download the agent setup</a>.</div>
        }
        else
        {
            <div class="table-scroll"><table class="table">
                <thead><tr><th scope="col">Computer</th><th scope="col">User</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Finished</th></tr></thead>
                <tbody>@foreach (var job in Model.Summary.RecentJobs)
                {
                    <tr><td><strong>@job.ComputerName</strong></td><td>@job.Username</td><td>@job.BackupType</td><td><span class="status" data-status="@job.Status">@job.Status</span></td><td>@(job.FinishedAt?.ToLocalTime().ToString("g") ?? "In progress")</td></tr>
                }</tbody>
            </table></div>
        }
    </section>
</div>
