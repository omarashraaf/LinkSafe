@page
@model LinkSafeServer.Pages.Logs.IndexModel
@{
    ViewData["Title"] = "Logs";
}

<section class="page-grid">
    <div class="hero-card">
        <h1>Server Logs</h1>
        <p>Review recent LinkSafe server events and download the current log file.</p>
        <div class="button-row">
            <a class="btn btn-primary" asp-page="/Logs/Index">Refresh</a>
            <a class="btn btn-outline-light" asp-page-handler="Download">Download Log File</a>
        </div>
    </div>

    <div class="panel-card">
        <p><strong>Log file:</strong> @Model.LogFilePath</p>
        <pre class="log-viewer">@string.Join(Environment.NewLine, Model.Lines)</pre>
    </div>
</section>
